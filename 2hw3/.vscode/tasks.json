{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "Debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "Debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure (Debug)",
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Rebuild (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "Debug", "--clean-first"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure (Debug)",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "Debug", "--target", "clean"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Flash (OpenOCD / ST-LINK)",
      "type": "shell",
      "command": "C:/STM32/openocd/bin/openocd.exe",
      "args": [
        "-s", "C:/STM32/openocd/openocd/scripts",
        "-f", "interface/stlink.cfg",
        "-f", "target/stm32f1x.cfg",
        "-c", "program build/Debug/${workspaceFolderBasename}.elf verify reset exit"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Build (Debug)",
      "problemMatcher": []
    },
    {
      "label": "Erase chip (OpenOCD / ST-LINK)",
      "type": "shell",
      "command": "C:/STM32/openocd/bin/openocd.exe",
      "args": [
        "-s", "C:/STM32/openocd/openocd/scripts",
        "-f", "interface/stlink.cfg",
        "-f", "target/stm32f1x.cfg",
        "-c", "init; reset halt; stm32f1x mass_erase 0; exit"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "List probes (CubeProgrammer)",
      "type": "shell",
      "command": "C:/Program Files/STMicroelectronics/STM32Cube/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
      "args": ["--list"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
