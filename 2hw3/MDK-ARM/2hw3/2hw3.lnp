--cpu Cortex-M3
"2hw3\startup_stm32f103xb.o"
"2hw3\main.o"
"2hw3\gpio.o"
"2hw3\adc.o"
"2hw3\stm32f1xx_it.o"
"2hw3\stm32f1xx_hal_msp.o"
"2hw3\stm32f1xx_hal_gpio_ex.o"
"2hw3\stm32f1xx_hal_adc.o"
"2hw3\stm32f1xx_hal_adc_ex.o"
"2hw3\stm32f1xx_hal.o"
"2hw3\stm32f1xx_hal_rcc.o"
"2hw3\stm32f1xx_hal_rcc_ex.o"
"2hw3\stm32f1xx_hal_gpio.o"
"2hw3\stm32f1xx_hal_dma.o"
"2hw3\stm32f1xx_hal_cortex.o"
"2hw3\stm32f1xx_hal_pwr.o"
"2hw3\stm32f1xx_hal_flash.o"
"2hw3\stm32f1xx_hal_flash_ex.o"
"2hw3\stm32f1xx_hal_exti.o"
"2hw3\system_stm32f1xx.o"
--strict --scatter "2hw3\2hw3.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "2hw3.map" -o 2hw3\2hw3.axf