{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (OpenOCD + ST-LINK)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${command:cmake.launchTargetPath}",
      "servertype": "openocd",
      "serverpath": "C:/STM32/openocd/bin/openocd.exe",
      "gdbPath": "C:/STM32/gcc/bin/arm-none-eabi-gdb.exe",
      "device": "STM32F103C8",
      "interface": "swd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "searchDir": ["C:/STM32/openocd/openocd/scripts"],
      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/STM32F103.svd",
      "preLaunchTask": "Build (Debug)",
      "showDevDebugOutput": "none"
    },
    {
      "name": "Attach (OpenOCD + ST-LINK)",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "executable": "${command:cmake.launchTargetPath}",
      "servertype": "openocd",
      "serverpath": "C:/STM32/openocd/bin/openocd.exe",
      "gdbPath": "C:/STM32/gcc/bin/arm-none-eabi-gdb.exe",
      "device": "STM32F103C8",
      "interface": "swd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "searchDir": ["C:/STM32/openocd/openocd/scripts"],
      "svdFile": "${workspaceFolder}/STM32F103.svd",
      "showDevDebugOutput": "none"
    }
  ]
}
